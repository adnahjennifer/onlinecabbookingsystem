# MySQL connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=cabgo_user
DB_PASSWORD=change-this-password
DB_NAME=cab_booking_system

# HTTP server
PORT=3000

# Optional routing/geocoding overrides
# NOMINATIM_URL=https://nominatim.openstreetmap.org/search
# OSRM_ROUTE_URL=https://router.project-osrm.org/route/v1/driving
# GEOCODE_TIMEOUT_MS=8000
# ROUTE_TIMEOUT_MS=10000

# Only needed when creating the first admin with npm run provision:admin
# INITIAL_ADMIN_EMAIL=admin@example.com
# INITIAL_ADMIN_PASSWORD=replace-with-a-local-password
# INITIAL_ADMIN_NAME=CabGo Admin
